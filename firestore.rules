rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection (PII Protection - strictly accessible only by the owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false; // Blanket user listing is forbidden

      allow create: if isValidId(userId) && isOwner(userId)
        && incoming().id == userId
        && incoming().keys().hasAll(['id', 'fullName', 'primaryEmail', 'phoneNumber', 'username', 'createdAt'])
        && incoming().fullName is string && incoming().fullName.size() <= 100
        && incoming().phoneNumber is string && incoming().phoneNumber.size() <= 30
        && incoming().username is string && incoming().username.size() <= 40;

      allow update: if isValidId(userId) && isOwner(userId)
        && incoming().id == userId
        && incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName',
            'alternativeEmail',
            'phoneNumber',
            'themePreference',
            'colorMode',
            'notificationPreferences',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    // Unique Username Registry
    match /usernames/{username} {
      allow get: if isSignedIn() && isValidId(username);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(username)
        && incoming().uid == request.auth.uid
        && incoming().keys().hasAll(['uid', 'createdAt']);
      allow update, delete: if false;
    }

    // Unique Phone Registry
    match /phones/{phone} {
      allow get: if isSignedIn() && isValidId(phone);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(phone)
        && incoming().uid == request.auth.uid
        && incoming().keys().hasAll(['uid', 'createdAt']);
      allow update, delete: if false;
    }

    // Unique Email Registry (Primary and Alternative)
    match /emails/{email} {
      allow get: if isSignedIn() && isValidId(email);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(email)
        && incoming().uid == request.auth.uid
        && incoming().keys().hasAll(['uid', 'type', 'createdAt']);
      allow update, delete: if false;
    }

    // Quiz Attempts Collection (Immutable study records)
    match /quiz_attempts/{attemptId} {
      allow get: if isSignedIn() && isValidId(attemptId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(attemptId)
        && incoming().userId == request.auth.uid
        && incoming().keys().hasAll(['attemptId', 'userId', 'topic', 'questionCount', 'correctAnswers', 'accuracy', 'submissionId'])
        && incoming().questionCount is number
        && incoming().correctAnswers is number
        && incoming().accuracy is number;

      allow update, delete: if false;
    }

    // User Progress Collection (Owner-specific learning aggregates)
    match /user_progress/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId) && isOwner(userId)
        && incoming().userId == userId
        && incoming().keys().hasAll(['userId', 'totalQuizzesCompleted', 'totalEarnedPoints', 'currentStreakDays']);

      allow update: if isValidId(userId) && isOwner(userId)
        && incoming().userId == userId
        && incoming().diff(existing()).affectedKeys().hasOnly([
            'totalQuizzesCompleted',
            'totalEarnedPoints',
            'averageAccuracy',
            'currentStreakDays',
            'lastActiveDate',
            'topicMastery',
            'earnedBadgeIds',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    // Public Leaderboard Collection (Safe public rankings)
    match /leaderboard/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;

      allow create: if isValidId(userId) && isOwner(userId)
        && incoming().userId == userId
        && incoming().keys().hasAll(['userId', 'displayName', 'username', 'points', 'accuracy', 'quizzesCompleted']);

      allow update: if isValidId(userId) && isOwner(userId)
        && incoming().userId == userId
        && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'username',
            'points',
            'accuracy',
            'quizzesCompleted',
            'streakDays',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    // Flashcards Collection (Student spaced repetition cards)
    match /flashcards/{flashcardId} {
      allow get: if isSignedIn() && isValidId(flashcardId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(flashcardId)
        && incoming().userId == request.auth.uid
        && incoming().keys().hasAll(['id', 'userId', 'deck', 'front', 'back', 'createdAt'])
        && incoming().front is string && incoming().front.size() <= 500
        && incoming().back is string && incoming().back.size() <= 1000;

      allow update: if isSignedIn() && isValidId(flashcardId)
        && resource.data.userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['front', 'back', 'hint', 'deck', 'difficulty', 'status', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(flashcardId) && resource.data.userId == request.auth.uid;
    }

    // Saved Documents Collection (Private study notes and syllabi)
    match /saved_documents/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(docId)
        && incoming().userId == request.auth.uid
        && incoming().keys().hasAll(['id', 'userId', 'name', 'size', 'createdAt'])
        && incoming().name is string && incoming().name.size() <= 200;

      allow update: if isSignedIn() && isValidId(docId)
        && resource.data.userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['extractedText', 'summary', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(docId) && resource.data.userId == request.auth.uid;
    }

    // Contest Entries Collection (Weekly challenge submissions)
    match /contest_entries/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(entryId)
        && incoming().userId == request.auth.uid
        && incoming().keys().hasAll(['id', 'userId', 'contestId', 'score', 'pointsEarned', 'completedAt']);

      allow update, delete: if false;
    }
  }
}
